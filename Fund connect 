
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fund Connect</title>
<style>
:root {
  --green: #168447;
  --dark: #183126;
  --light: #eaf7ef;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f7fbf8;
  color: var(--dark);
  line-height: 1.6;
}
header {
  background: white;
  padding: 16px;
  border-bottom: 1px solid #dce9e0;
}
nav {
  max-width: 1000px;
  margin: auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.logo {
  font-size: 24px;
  font-weight: bold;
  color: var(--green);
}
nav a {
  text-decoration: none;
  color: var(--dark);
  margin: 5px;
  font-weight: bold;
}
main {
  max-width: 1000px;
  margin: auto;
  padding: 25px 16px;
}
.hero {
  text-align: center;
  padding: 55px 20px;
  background: var(--light);
  border-radius: 18px;
}
.hero h1 { font-size: 38px; }
.hero p { color: #61736a; }
button, .button {
  background: var(--green);
  color: white;
  border: none;
  padding: 12px 18px;
  border-radius: 8px;
  font-weight: bold;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
}
.secondary {
  background: white;
  color: var(--green);
  border: 1px solid var(--green);
}
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
  gap: 16px;
}
.card, .panel {
  background: white;
  border: 1px solid #dce9e0;
  border-radius: 14px;
  padding: 20px;
}
.panel {
  max-width: 460px;
  margin: 25px auto;
}
.panel h2 { text-align: center; }
label {
  display: block;
  font-weight: bold;
  margin-top: 14px;
}
input {
  width: 100%;
  padding: 13px;
  border: 1px solid #cbdacf;
  border-radius: 8px;
  margin-top: 5px;
  font-size: 16px;
}
.full { width: 100%; margin-top: 20px; }
.note {
  background: #fff4d6;
  padding: 12px;
  border-radius: 8px;
  color: #704e00;
  font-size: 13px;
  margin-top: 15px;
}
.switch { text-align: center; }
.switch a { color: var(--green); font-weight: bold; }
.hidden { display: none; }
footer {
  background: #103d26;
  color: white;
  text-align: center;
  padding: 25px;
  margin-top: 40px;
}
</style>
</head>
<body>

<header>
<nav>
<div class="logo">Fund Connect</div>
<div>
<a href="#home" onclick="showPage('home')">Home</a>
<a href="#explore" onclick="showPage('home')">Explore</a>
<a href="#login" onclick="showPage('login')">Login</a>
<a href="#signup" onclick="showPage('signup')">Sign Up</a>
</div>
</nav>
</header>

<main>

<div id="home">
<section class="hero">
<h1>Together, We Can Make a Difference.</h1>
<p>Connect with people, support meaningful causes and bring hope to communities around the world.</p>
<button onclick="showPage('signup')">Create Account</button>
<button class="secondary" onclick="showPage('login')">Login</button>
</section>

<section id="explore">
<h2>Explore Campaigns</h2>
<p>Example campaigns for demonstration only.</p>
<div class="cards">
<div class="card">
<h3>📚 Education Support</h3>
<p>A sample campaign supporting learning opportunities.</p>
</div>
<div class="card">
<h3>🏘️ Community Projects</h3>
<p>A sample campaign for community development.</p>
</div>
<div class="card">
<h3>🌱 Green Environment</h3>
<p>A sample campaign for a greener future.</p>
</div>
</div>
</section>

<section>
<h2>About Fund Connect</h2>
<p>Our goal is to connect people with meaningful causes and make it easier to share fundraising stories.</p>
</section>
</div>

<div id="signup" class="hidden">
<div class="panel">
<h2>Create Your Account</h2>
<form id="signupForm">
<label>Full Name</label>
<input type="text" placeholder="Enter your name" required>

<label>Email Address</label>
<input type="email" placeholder="Enter your email" required>

<label>Password</label>
<input type="password" placeholder="Demo only — do not enter a real password" required>

<button class="full" type="submit">Create Account</button>
</form>
<div class="note">
Demo only: account registration is not connected. No account or password is saved. Do not enter real passwords or sensitive information.
</div>
<p class="switch">Already registered?
<a href="#login" onclick="showPage('login')">Login here</a>
</p>
</div>
</div>

<div id="login" class="hidden">
<div class="panel">
<h2>Welcome Back</h2>
<form id="loginForm">
<label>Email Address</label>
<input type="email" placeholder="Enter your email" required>

<label>Password</label>
<input type="password" placeholder="Demo only — do not enter a real password" required>

<button class="full" type="submit">Login</button>
</form>
<div class="note">
Demo only: login is not connected and does not check or save passwords.
</div>
<p class="switch">New to Fund Connect?
<a href="#signup" onclick="showPage('signup')">Create Account</a>
</p>
</div>
</div>

</main>

<footer>
<h3>Fund Connect</h3>
<p>Connecting people with causes.</p>
<p>Early website prototype — real donations are not enabled.</p>
</footer>

<script>
function showPage(page) {
  document.getElementById('home').classList.toggle('hidden', page !== 'home');
  document.getElementById('signup').classList.toggle('hidden', page !== 'signup');
  document.getElementById('login').classList.toggle('hidden', page !== 'login');
  window.scrollTo(0,0);
}

document.getElementById('signupForm').addEventListener('submit', function(e) {
  e.preventDefault();
  alert('This is a demonstration. Account registration is not active yet.');
});

document.getElementById('loginForm').addEventListener('submit', function(e) {
  e.preventDefault();
  alert('This is a demonstration. Login is not active yet.');
});

window.addEventListener('hashchange', function() {
  const page = location.hash.slice(1);
  showPage(page === 'signup' || page === 'login' ? page : 'home');
});

if (location.hash === '#signup' || location.hash === '#login') {
  showPage(location.hash.slice(1));
}
</script>

</body>
</html>
